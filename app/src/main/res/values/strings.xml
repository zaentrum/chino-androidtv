<?xml version="1.0" encoding="utf-8"?>
<!-- app_name comes from the Gradle product flavors (beta / prod) — see app/build.gradle.kts. -->
<resources>
    <string name="auth_title">Connect your Chino account</string>
    <string name="auth_instructions">On your phone or laptop, open</string>
    <string name="auth_qr_or">Scan with your phone — or visit:</string>
    <string name="auth_qr_description">QR code to open the sign-in page on your phone</string>
    <string name="auth_enter_code">and enter this code:</string>
    <string name="auth_waiting">Waiting for confirmation…</string>
    <string name="auth_retry">Try again</string>
    <string name="auth_error_prefix">Could not start sign-in: </string>

    <string name="library_title">Recently added — Movies</string>
    <string name="library_loading">Loading your library…</string>
    <string name="library_empty">No items yet.</string>
    <string name="library_error_title">couldn\'t load the library</string>

    <!-- A screen whose content did not load (LoadError): the reason only, as
         "try again" is the button; only what no button offers, an app
         update, is said in words. -->
    <string name="load_error_body">Can\'t reach the server.</string>
    <string name="load_error_body_server">The server ran into a problem.</string>
    <string name="load_error_body_busy">The server is busy.</string>
    <string name="load_error_body_rejected">The server didn\'t accept the request. Check for an app update.</string>
    <string name="load_error_retry">try again</string>
    <string name="load_error_back">back</string>
    <string name="load_error_details">details</string>
    <!-- What the screen shows, gone (404, 410): "this title isn't in the library anymore". -->
    <string name="gone_title">%1$s isn\'t in the library anymore</string>
    <!-- No access (403): "you don't have access to this title"; "this" where the screen does not know. -->
    <string name="forbidden_title">you don\'t have access to %1$s</string>
    <string name="forbidden_this">this</string>
    <!-- Signed out (401), where going to sign-in by itself could not spare a screen. -->
    <string name="signed_out_title">you\'re signed out</string>
    <string name="signed_out_body">Sign in again to keep watching.</string>
    <string name="signed_out_action">sign in</string>
</resources>
